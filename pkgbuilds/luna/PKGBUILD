# Maintainer: Carlos Prieto Ortiz <prietus@live.com>

pkgname=luna
pkgver=0.1.0
pkgrel=1
pkgdesc='GTK4 client for Borg backup repositories, with tray icon, systemd schedules, BorgBase and BorgBox panels'
url='https://github.com/prietus/luna'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gtk4' 'libadwaita' 'gtk4-layer-shell' 'glib2' 'cairo' 'pango' 'gdk-pixbuf2'
         'borg' 'libsecret' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=('libnotify: notifications when a scheduled backup ends'
            'openssh: SSH, BorgBase and BorgBox repositories'
            'python-pyfuse3: mounting archives'
            'gnome-keyring: a Secret Service keyring for the passphrases (or KeePassXC, KWallet...)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('b88521fb05cf5f41b095163763c5d49f89700e51bd764fa434847ed80c5b86f3')

prepare() {
  cd $pkgname-$pkgver
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $pkgname-$pkgver
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd $pkgname-$pkgver
  # binary, desktop entry, icons and LICENSE
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
